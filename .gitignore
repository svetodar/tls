# Build artifacts (Free Pascal)
build/
bin/
*.o
*.ppu
*.a
*.or
*.compiled
*.res
*.lps

# Local secrets and generated key material.
# Test keys are regenerated by `make fixtures` (tests/fixtures/gen_certs.sh);
# they are local only and never committed.
*.key
*.pem
id_*
.env
.env.*
*secret*
*token*
*.log

# Reference copy of upstream OpenSSL sources (see docs/openssl-reference.md).
# Downloaded locally, not part of the repository.
OpenSSL/

# Local reference copies of FPC/FCL units used while implementing the socket
# handler (sslsockets.pp, opensslsockets.pp, ssockets.pp). Not built or shipped.
docs/reference/

# Local agent configuration (may contain API keys). Never committed.
.subag/

# Editors / OS noise
.DS_Store
*.bak
