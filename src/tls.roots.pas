unit tls.roots;

{ Embedded root certificates.

  Layer 2 (verification). This is the only unit that names the root
  resource: a DER table (format in tls.roottable) generated by
  `make roots` from certs/roots.pem and carried inside the host executable
  as an RT_RCDATA resource named TLSROOTS. Reading it needs no file, no
  directory layout and no OS certificate store; the table is decoded and
  turned into a TCertStore by tls.roottable, so all parsing stays in this
  library. EmbeddedRoots builds that store on first use, once per process,
  and caches it; EmbeddedRootsTableBytes is the low-level accessor.
  EmbeddedRootsDate reports the snapshot date, EmbeddedRootsIsStale turns it
  into an age flag, and ReleaseEmbeddedRoots drops the cache for tests.

  Every read of the resource is integrity-checked first: the reader recomputes
  SHA-256 over the table payload and compares it with the digest stored in the
  table header, exactly as tools/rootsgen wrote it. A truncated or replaced
  resource therefore raises ECertBundleError instead of decoding into a
  quietly weaker trust store.

  The compiler directive below (`$R tlsroots.res`) embeds the table into
  the unit, which the compiler then links into the program that uses it.
  Build with -dTLS_NO_EMBEDDED_ROOTS (or make without fpcres) to compile
  the unit without the resource: it still compiles and raises
  ECertBundleError with a clear message instead of returning an empty
  trust store.

  The PEM snapshot stays the source of truth in git; src/tlsroots.res is
  generated, not committed. }

{$mode objfpc}{$H+}

{$ifndef TLS_NO_EMBEDDED_ROOTS}
  {$R tlsroots.res}
{$endif}

interface

uses
  SysUtils,      { TBytes }
  tls.certstore; { TCertStore }

const
  { Name of the RT_RCDATA resource that holds the DER root table. }
  TLS_ROOTS_RESOURCE_NAME = 'TLSROOTS';

{ The embedded root table exactly as stored in the resource: header,
  records and DER blobs, i.e. the bytes DecodeRootTable expects. A copy is
  returned, so the caller owns it.

  Low-level accessor: DecodeRootTable/BuildCertStore validate the bytes and
  the regular entry point is the lazily cached EmbeddedRoots store.

  The bytes are integrity-checked here, before they are handed out: SHA-256 is
  recomputed over the payload (everything after the header) and compared with
  the digest stored in the header. A mismatch means the resource was truncated
  or replaced after `make roots` produced it.

  Raises ECertBundleError when the resource is missing (built without it),
  empty, corrupted (failed SHA-256 self-check), or when the unit was compiled
  with TLS_NO_EMBEDDED_ROOTS. It never falls back to an empty table. }
function EmbeddedRootsTableBytes: TBytes;

{ The integrity check EmbeddedRootsTableBytes applies to whatever it read:
  recompute SHA-256 over the table payload (everything after the fixed header)
  and compare it with the digest stored in the header.

  Public so that the failure path can be exercised on tampered bytes, which a
  resource embedded in the executable does not allow; ordinary callers rely on
  EmbeddedRootsTableBytes, EmbeddedRoots and EmbeddedRootsDate, which call this
  for them. Raises ECertBundleError when ATable is too short to hold a header
  or when the digests differ; returns normally otherwise. A table that passes
  is only *unaltered* -- DecodeRootTable still validates its structure. }
procedure VerifyEmbeddedRootsSha256(const ATable: TBytes);

{ The embedded roots as a trust store, built lazily on the first call from
  the resource and cached for the lifetime of the process.

  The resource is read and parsed at most once: concurrent first calls block
  on a critical section, and all of them receive the same store (double
  checked initialisation). The unit owns the store, so callers must not free
  it.

  Raises ECertBundleError when the resource is missing, empty or corrupted
  (see EmbeddedRootsTableBytes); a failed attempt caches nothing, so a later
  call retries instead of seeing a half-built store. }
function EmbeddedRoots: TCertStore;

{ Snapshot date of the embedded roots: the date from the table header, with
  no time-of-day part (UTC).

  Uses the same lazily decoded table as EmbeddedRoots, so the resource is
  still read at most once per process. Raises ECertBundleError when the
  resource is missing, empty or corrupted, exactly like EmbeddedRoots. }
function EmbeddedRootsDate: TDateTime;

{ True when the embedded snapshot is older than AMaxAgeDays days.

  A staleness flag, not an error: verification keeps working with an old
  snapshot and the caller decides whether to warn, refresh or refuse. The age
  is measured from EmbeddedRootsDate, so a snapshot dated in the future is
  never stale and a snapshot exactly AMaxAgeDays old is not stale yet.

  AMaxAgeDays must not be negative (EArgumentOutOfRangeException otherwise).
  Raises ECertBundleError like EmbeddedRootsDate. }
function EmbeddedRootsIsStale(const ANow: TDateTime;
  AMaxAgeDays: LongInt = 365): Boolean;

{ Drop the cached store and the decoded table, so that the next EmbeddedRoots
  or EmbeddedRootsDate call reads the resource again and rebuilds them.

  Meant for tests and leak checks: pointers obtained before the call become
  invalid. Ordinary callers never need it, because the unit frees everything
  at process exit. }
procedure ReleaseEmbeddedRoots;

implementation

uses
  Classes,          { TResourceStream }
  tls.roottable,    { ECertBundleError, ROOT_TABLE_*, TRootTable,
                      DecodeRootTable, CertStoreFromTable }
  tls.sha2,         { SHA256, BytesToHex }
  {$ifdef windows}Windows, {$endif} { RT_RCDATA on Windows }
  { Last on purpose: the Windows unit declares TCRITICALSECTION (a
    TRTLCriticalSection record) and Pascal identifiers ignore case, so the
    SyncObjs class has to be the one found first, i.e. from the last unit. }
  SyncObjs       { TCriticalSection }
  ;

var
  { The cached decoded table, the store built from it, and the lock that guards
    their creation. Both are published once and afterwards only read, so the
    fast path can inspect the pointers without the lock; the lock makes sure the
    resource is read and parsed exactly once when threads race on the first
    call. }
  EmbeddedRootsLock: TCriticalSection;
  EmbeddedRootsDecoded: TRootTable;
  EmbeddedRootsStore: TCertStore;

{ The header carries SHA-256 of everything after it (records plus DER blobs,
  see tls.roottable). Recompute it over the bytes actually read from the
  resource and compare: DecodeRootTable only checks that the records are
  mutually consistent, so a truncated link-time resource or a table embedded
  from the wrong file (roots silently dropped, distrusted bits flipped) would
  decode fine. The check makes such a resource a hard error instead of a
  quietly weaker trust store.

  Runs before decoding, on every read, so EmbeddedRootsTableBytes reports the
  corruption too and not only the cached EmbeddedRoots. The digests are
  compared byte by byte without an early exit: the values are public, but a
  constant-time comparison costs nothing here and keeps one pattern for every
  digest check in the library. }
procedure VerifyEmbeddedRootsSha256(const ATable: TBytes);
var
  TableLen, PayloadLen, I: Integer;
  Payload, Actual, Stored: TBytes;
  Diff: Byte;
begin
  TableLen := Length(ATable);
  if TableLen < ROOT_TABLE_HEADER_SIZE then
    raise ECertBundleError.CreateFmt(
      'embedded roots are corrupted: table is truncated to %d bytes, the ' +
      'header needs %d', [TableLen, ROOT_TABLE_HEADER_SIZE]);

  PayloadLen := TableLen - ROOT_TABLE_PAYLOAD_OFS;
  Payload := Copy(ATable, ROOT_TABLE_PAYLOAD_OFS, PayloadLen);
  Actual := SHA256(Payload);

  Diff := 0;
  for I := 0 to ROOT_TABLE_SHA256_LEN - 1 do
    Diff := Diff or (Actual[I] xor ATable[ROOT_TABLE_HDR_SHA256_OFS + I]);
  if Diff <> 0 then
  begin
    Stored := Copy(ATable, ROOT_TABLE_HDR_SHA256_OFS, ROOT_TABLE_SHA256_LEN);
    raise ECertBundleError.CreateFmt(
      'embedded roots are corrupted: the header says sha256=%s, the payload ' +
      'hashes to %s', [BytesToHex(Stored), BytesToHex(Actual)]);
  end;
end;

function EmbeddedRootsTableBytes: TBytes;
{$ifndef TLS_NO_EMBEDDED_ROOTS}
var
  Stream: TResourceStream;
{$endif}
begin
  Result := nil;
{$ifdef TLS_NO_EMBEDDED_ROOTS}
  raise ECertBundleError.Create(
    'embedded roots are unavailable: the library was built without them ' +
    '(TLS_NO_EMBEDDED_ROOTS)');
{$else}
  { A missing resource is a build error, not an empty trust store: report it
    as the typed bundle error instead of letting EResNotFound escape. }
  try
    Stream := TResourceStream.Create(HInstance, TLS_ROOTS_RESOURCE_NAME,
      RT_RCDATA);
  except
    on E: Exception do
      raise ECertBundleError.CreateFmt(
        'embedded roots resource "%s" is missing: %s',
        [TLS_ROOTS_RESOURCE_NAME, E.Message]);
  end;
  try
    if Stream.Size <= 0 then
      raise ECertBundleError.CreateFmt(
        'embedded roots resource "%s" is empty', [TLS_ROOTS_RESOURCE_NAME]);
    SetLength(Result, Stream.Size);
    Stream.ReadBuffer(Result[0], Length(Result));
  finally
    Stream.Free;
  end;
  { Verify the bytes before they reach the decoder: the resource is the one
    input a broken build can silently replace or truncate, and a table whose
    header and records agree with each other would otherwise decode into a
    weaker trust store without a word. }
  VerifyEmbeddedRootsSha256(Result);
{$endif}
end;

{ Decode the table unless that already happened. The caller must hold
  EmbeddedRootsLock: this helper never takes the lock itself, so the public
  functions below can decode and build the store under a single acquisition
  (no nested locking). }
procedure EnsureEmbeddedRootsDecoded;
begin
  if EmbeddedRootsDecoded = nil then
    { DecodeRootTable validates the header and every record against the real
      table size and raises ECertBundleError when the resource is missing or
      malformed, and EmbeddedRootsTableBytes has already rejected a resource
      whose SHA-256 does not match its header. Nothing is assigned in either
      case, so a later call retries instead of handing out an empty trust
      store. }
    EmbeddedRootsDecoded := DecodeRootTable(EmbeddedRootsTableBytes);
end;

{ The cached decoded table, decoded on first use. Raises ECertBundleError when
  the resource is missing, empty or corrupted. }
function GetEmbeddedRootsTable: TRootTable;
begin
  { Fast path: the table was published by this or by another thread. }
  Result := EmbeddedRootsDecoded;
  if Result <> nil then
    Exit;

  EmbeddedRootsLock.Acquire;
  try
    { Second check under the lock: another thread may have decoded the table
      while this one was waiting for the critical section. }
    EnsureEmbeddedRootsDecoded;
    Result := EmbeddedRootsDecoded;
  finally
    EmbeddedRootsLock.Release;
  end;
end;

function EmbeddedRoots: TCertStore;
begin
  { Fast path: the store was published by this or by another thread. }
  Result := EmbeddedRootsStore;
  if Result <> nil then
    Exit;

  EmbeddedRootsLock.Acquire;
  try
    { Second check under the lock: another thread may have built the store
      while this one was waiting for the critical section. }
    if EmbeddedRootsStore = nil then
    begin
      EnsureEmbeddedRootsDecoded;
      { CertStoreFromTable parses every DER blob and raises ECertBundleError
        when one of them is not a well-formed certificate. Nothing is assigned
        in that case, so a later call retries instead of handing out a partial
        trust store. }
      EmbeddedRootsStore := CertStoreFromTable(EmbeddedRootsDecoded);
    end;
    Result := EmbeddedRootsStore;
  finally
    EmbeddedRootsLock.Release;
  end;
end;

function EmbeddedRootsDate: TDateTime;
begin
  Result := GetEmbeddedRootsTable.SnapshotDate;
end;

function EmbeddedRootsIsStale(const ANow: TDateTime;
  AMaxAgeDays: LongInt): Boolean;
begin
  if AMaxAgeDays < 0 then
    raise EArgumentOutOfRangeException.CreateFmt(
      'EmbeddedRootsIsStale: AMaxAgeDays must not be negative, got %d',
      [AMaxAgeDays]);
  { Compare ages in days so the flag does not depend on the time-of-day part of
    ANow (the snapshot date has none). A snapshot dated in the future has a
    negative age and is therefore not stale; one exactly AMaxAgeDays old is not
    stale yet, it becomes stale a moment later. }
  Result := ANow - GetEmbeddedRootsTable.SnapshotDate > AMaxAgeDays;
end;

procedure ReleaseEmbeddedRoots;
begin
  EmbeddedRootsLock.Acquire;
  try
    FreeAndNil(EmbeddedRootsStore);
    FreeAndNil(EmbeddedRootsDecoded);
  finally
    EmbeddedRootsLock.Release;
  end;
end;

initialization
  { Created eagerly so that the very first EmbeddedRoots call needs no extra
    synchronisation; the table and the store themselves stay lazy. }
  EmbeddedRootsLock := TCriticalSection.Create;

finalization
  { Same order as ReleaseEmbeddedRoots: the store points into certificates it
    parsed from the table, so it goes first. }
  FreeAndNil(EmbeddedRootsStore);
  FreeAndNil(EmbeddedRootsDecoded);
  EmbeddedRootsLock.Free;

end.
